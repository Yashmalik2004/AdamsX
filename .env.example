# Copy to .env for local dev. On the host (Render, etc.), set these in the dashboard — never commit .env.

PORT=3000
# Public URL of this service (no trailing slash). Required in production so cron can call /check-alerts.
# Example: https://adams-api.onrender.com
PUBLIC_URL=

DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

VET_EMAIL=
VET_EMAIL_PASS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
